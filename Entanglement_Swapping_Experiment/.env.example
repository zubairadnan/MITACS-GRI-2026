# Copy to .env and fill in. Never commit .env.
# API key from https://quantum.cloud.ibm.com (top-right "Create API key")
QISKIT_IBM_TOKEN=
# Instance CRN (optional; leave empty to let the service pick your default instance)
QISKIT_IBM_INSTANCE=
# Backend name, e.g. ibm_torino (optional; empty -> least busy backend)
IBM_BACKEND=
